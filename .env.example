# ──────────────────────────────────────────────────────────────────────────────
# ChatDART 환경 변수 예시
# 복사 후 .env 로 이름 변경하고 값을 채우세요.
#   cp .env.example .env
# .env 파일은 git에 포함되지 않습니다 (.gitignore 처리됨).
# ──────────────────────────────────────────────────────────────────────────────

# ── [필수] DART 전자공시 API 키 ───────────────────────────────────────────────
# 발급: https://opendart.fss.or.kr → 인증키 신청
DART_API_KEY=your_dart_api_key_here
KRX_API_KEY=                      # KRX 공식 API 키(선택). config.py 에 선언된 뒤에만 .env 에 넣을 것 — 미선언 변수는 기동을 막는다(O47)

# ── [필수] 데이터베이스 연결 URL ──────────────────────────────────────────────
# 로컬 개발 (SQLite):
DATABASE_URL=sqlite:///./chatdart.db
# 프로덕션 / Docker Compose (PostgreSQL):
# DATABASE_URL=postgresql://chatdart:비밀번호@db:5432/chatdart

# ── [필수] API 인증 키 ────────────────────────────────────────────────────────
# 모든 /api/v1/finance/* 요청의 X-API-Key 헤더에 사용됨.
# 생성 예시: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your_api_secret_key_here

# ── [필수] JWT 서명 키 ────────────────────────────────────────────────────────
# 회원 인증(JWT access/refresh 토큰) 서명에 사용됨.
# 빈 값이면 서버는 물론 pytest도 기동 단계에서 실패한다(config.py validator).
# 생성 예시: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# ── [선택] 결제 PG 설정 ───────────────────────────────────────────────
PG_PROVIDER=portone

# REST API 키 (결제 재조회용)
PORTONE_API_KEY=
PORTONE_API_SECRET=
TOSS_SECRET_KEY=

# Webhook HMAC 검증 키 (PG_PROVIDER에 따라 하나가 운영/staging에서 필수)
PORTONE_WEBHOOK_SECRET=      # 포트원 콘솔에서 발급. whsec_<base64> 형식
TOSS_WEBHOOK_SECRET_KEY=     # 토스 개발자센터에서 발급

# Development 전용 fallback (운영/staging에서는 HMAC을 사용)
# 생성 예시: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_webhook_secret_here

# ── [필수] 실행 환경 ──────────────────────────────────────────────────────────
# development | staging | production
# production/staging은 JSON 로그 출력, Sentry 활성화됨
ENV=development

# ── [선택] Sentry 에러 트래킹 ────────────────────────────────────────────────
# https://sentry.io 에서 DSN 발급. 없으면 빈 칸으로 두세요.
SENTRY_DSN=  # production/staging required

# Required when REQUIRE_EMAIL_VERIFICATION=true
REQUIRE_EMAIL_VERIFICATION=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── [선택] CORS 허용 프론트엔드 주소 ─────────────────────────────────────────
# 로컬: http://localhost:3000
# 배포: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# FRONTEND_URL 외 추가 허용 origin (콤마 구분, scheme·port 포함, 후행 슬래시 없이)
# 예: CORS_EXTRA_ORIGINS=http://118.36.70.42:3000
CORS_EXTRA_ORIGINS=

# Demo account auto-seed. When both values are set, startup creates or resets
# this non-admin demo user.
DEMO_EMAIL=
DEMO_PASSWORD=

# ── [선택] DART API 재시도 간격(초, 콤마 구분) ────────────────────────────────
# 기본값: 5초 → 30초 → 120초 순서로 재시도
DART_RETRY_DELAYS=5,30,120

# ── [선택] AI 분석 요약 ──────────────────────────────────────────────────────
# 미설정 시 /api/v1/finance/summary/ai-analysis 는 예측만 반환하고 summary_available=false가 됩니다.
OPENAI_API_KEY=
AI_DAILY_LIMIT=100

# Startup Alembic migration failure policy. True=stop startup on failure (default), False=log and continue.
STRICT_MIGRATION=True
# Run startup background auto-collection/cache prewarm. True=enabled (default), False=skip prewarm threads for demos.
ENABLE_BACKGROUND_PREWARM=True
